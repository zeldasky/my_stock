# 이 파일을 .env 로 복사해서 쓰세요. .env 는 git 에 올라가지 않습니다.

# 세션 쿠키 서명 키 — 외부 노출 전에 반드시 바꾸세요.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# 로컬 SQLite (기본값). AWS 로 옮길 때는 아래처럼 바꾸면 됩니다.
#   DATABASE_URL=postgresql+psycopg://user:pw@host:5432/my_stock
# DATABASE_URL=sqlite:///./my_stock.db

# 장 마감 후 시세 수집 시각 (KST)
SCHEDULER_ENABLED=true
SCHEDULER_HOUR=18
TIMEZONE=Asia/Seoul

# 연휴로 시세가 빌 때 거슬러 올라갈 일수
QUOTE_LOOKBACK_DAYS=10
